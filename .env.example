# =============================================================================
# Copier ce fichier en .env et remplir les valeurs.
#   cp .env.example .env
# .env est ignore par git : AUCUNE cle ne doit etre commitee.
# =============================================================================

# --- Voyage AI ---------------------------------------------------------------
# Cle creee dans MongoDB Atlas (Services -> Model API Keys), ou sur
# l'ancienne plateforme Voyage (cles commencant par "pa-").
VOYAGE_API_KEY=

# Laisser vide : l'URL est deduite du prefixe de la cle.
# A ne renseigner que pour forcer un endpoint precis, par exemple
# https://eu.ai.mongodb.com/v1 pour une cle limitee a l'Europe.
VOYAGE_API_BASE_URL=

# Modele d'embedding. Recommande : voyage-context-4 (embeddings contextualises).
# Alternatives : voyage-4-large, voyage-4, voyage-law-2.
EMBEDDING_MODEL=voyage-context-4

# "contextualized" (voyage-context-4 uniquement) ou "standard" (tous les autres).
EMBEDDING_MODE=contextualized

# 256 | 512 | 1024 | 2048  (Matryoshka). 1024 est le defaut raisonnable.
EMBEDDING_DIMENSION=1024

# --- Google Drive ------------------------------------------------------------
# Chemin vers le JSON du compte de service (hors du depot de preference).
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# ID du dossier Drive contenant les .txt (segment apres /folders/ dans l'URL).
DRIVE_FOLDER_ID=1TwWEQk33CI9M8v_mdj2gpKPoOKariJm2

# Explorer aussi les sous-dossiers.
DRIVE_RECURSIVE=true

# --- Chunking ----------------------------------------------------------------
# Retirer les en-tetes/pieds de page repetes avant le chunking.
STRIP_BOILERPLATE=true

CHUNK_TOKENS=800
CHUNK_OVERLAP_TOKENS=150

# Debit. Un compte SANS moyen de paiement enregistre est plafonne a
# 3 requetes et 10 000 tokens par minute : garder les valeurs ci-dessous.
# Avec un moyen de paiement (les 200 M de tokens offerts s'appliquent
# toujours), passer a 200 / 800000 pour aller beaucoup plus vite.
MAX_REQUESTS_PER_MINUTE=2
MAX_TOKENS_PER_MINUTE=8000

# --- Chemins locaux ----------------------------------------------------------
INDEX_DIR=./data/index
CACHE_DIR=./data/cache

# --- Base vectorielle (Qdrant) ----------------------------------------------
QDRANT_COLLECTION=legalrag

# Laisser QDRANT_URL vide pour le mode embarque : Qdrant ecrit dans
# QDRANT_PATH, sans serveur ni Docker. Un seul processus a la fois.
# Pour un serveur   : QDRANT_URL=http://localhost:6333
# Pour Qdrant Cloud : QDRANT_URL=https://xxx.cloud.qdrant.io:6333 + QDRANT_API_KEY
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant
QDRANT_BATCH=128

# --- Recherche (retrieval) ---------------------------------------------------
# Modele de reranking. rerank-3 (0,05 $/Mtok) ou rerank-3-lite (0,02 $/Mtok),
# tous deux avec 200 M de tokens offerts.
RERANK_MODEL=rerank-3
RERANK_ENABLED=true

# Chunks ramenes par la recherche vectorielle, puis passages renvoyes apres
# reranking. Monter TOP_K ameliore le rappel au prix de la latence.
RETRIEVAL_TOP_K=25
RETRIEVAL_TOP_N=5

# --- Generation de la reponse ------------------------------------------------
# Deux fournisseurs peuvent coexister : l'interface web laisse alors choisir
# lequel redige la reponse. Seuls ceux dont la cle est renseignee sont
# proposes ; sans aucune cle, la recherche fonctionne encore et rend les
# extraits bruts.

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# llama-3.3-70b-versatile a ete deprecie par Groq le 17 juin 2026 pour les
# tiers gratuit et developpeur. Remplacants recommandes par Groq :
# openai/gpt-oss-120b (0,15/0,60 $ par Mtok) ou qwen/qwen3.6-27b.
GENERATION_MODEL=openai/gpt-oss-120b
GENERATION_MAX_TOKENS=2048

# Claude (Anthropic) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Ce plafond couvre le raisonnement *et* la reponse : Sonnet 5 raisonne avant
# de repondre, et max_tokens borne le total. Trop bas, la reponse est coupee
# au milieu d'une phrase — l'interface le signale alors explicitement.
ANTHROPIC_MAX_TOKENS=4096

# Effort de raisonnement : low | medium | high | xhigh | max. `low` suffit
# ici, la tache etant de citer des extraits fournis, non de les resoudre.
ANTHROPIC_EFFORT=low

# Modele preselectionne dans l'interface : groq | claude. S'il n'a pas de cle,
# le premier modele configure prend le relais.
GENERATION_DEFAULT=groq

# --- Source du corpus --------------------------------------------------------
# "drive" (Google Drive) ou "local" (repertoire de .txt produits par l'ingestion
# de PDF). En local, les variables DRIVE_* et GOOGLE_* ne sont pas requises.
CORPUS_SOURCE=drive
LOCAL_CORPUS_DIR=./data/corpus/fr

# --- Statut juridique des textes --------------------------------------------
# Registre document_id -> en_vigueur | abroge | inconnu. Resolu a la
# recherche : le modifier ne demande aucun reembedding.
STATUTS_FILE=./data/statuts.json
