# =============================================================================
# Copier ce fichier en .env et remplir les valeurs.
#   cp .env.example .env
# .env est ignore par git : AUCUNE cle ne doit etre commitee.
# =============================================================================

# --- Voyage AI ---------------------------------------------------------------
# https://dashboard.voyageai.com/  ->  API Keys
VOYAGE_API_KEY=

# Modele d'embedding. Recommande : voyage-context-4 (embeddings contextualises).
# Alternatives : voyage-4-large, voyage-4, voyage-law-2.
EMBEDDING_MODEL=voyage-context-4

# "contextualized" (voyage-context-4 uniquement) ou "standard" (tous les autres).
EMBEDDING_MODE=contextualized

# 256 | 512 | 1024 | 2048  (Matryoshka). 1024 est le defaut raisonnable.
EMBEDDING_DIMENSION=1024

# --- Google Drive ------------------------------------------------------------
# Chemin vers le JSON du compte de service (hors du depot de preference).
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# ID du dossier Drive contenant les .txt (segment apres /folders/ dans l'URL).
DRIVE_FOLDER_ID=1TwWEQk33CI9M8v_mdj2gpKPoOKariJm2

# Explorer aussi les sous-dossiers.
DRIVE_RECURSIVE=true

# --- Chunking ----------------------------------------------------------------
CHUNK_TOKENS=800
CHUNK_OVERLAP_TOKENS=150

# --- Debit (garde-fous cote client, en-deca des quotas Voyage) ---------------
MAX_REQUESTS_PER_MINUTE=200
MAX_TOKENS_PER_MINUTE=800000

# --- Chemins locaux ----------------------------------------------------------
INDEX_DIR=./data/index
CACHE_DIR=./data/cache
