# =============================================================================
# Copier ce fichier en .env et remplir les valeurs.
#   cp .env.example .env
# .env est ignore par git : AUCUNE cle ne doit etre commitee.
# =============================================================================

# --- Voyage AI ---------------------------------------------------------------
# Cle creee dans MongoDB Atlas (Services -> Model API Keys), ou sur
# l'ancienne plateforme Voyage (cles commencant par "pa-").
VOYAGE_API_KEY=

# Laisser vide : l'URL est deduite du prefixe de la cle.
# A ne renseigner que pour forcer un endpoint precis, par exemple
# https://eu.ai.mongodb.com/v1 pour une cle limitee a l'Europe.
VOYAGE_API_BASE_URL=

# Modele d'embedding. Recommande : voyage-context-4 (embeddings contextualises).
# Alternatives : voyage-4-large, voyage-4, voyage-law-2.
EMBEDDING_MODEL=voyage-context-4

# "contextualized" (voyage-context-4 uniquement) ou "standard" (tous les autres).
EMBEDDING_MODE=contextualized

# 256 | 512 | 1024 | 2048  (Matryoshka). 1024 est le defaut raisonnable.
EMBEDDING_DIMENSION=1024

# --- Google Drive ------------------------------------------------------------
# Chemin vers le JSON du compte de service (hors du depot de preference).
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# ID du dossier Drive contenant les .txt (segment apres /folders/ dans l'URL).
DRIVE_FOLDER_ID=1TwWEQk33CI9M8v_mdj2gpKPoOKariJm2

# Explorer aussi les sous-dossiers.
DRIVE_RECURSIVE=true

# --- Chunking ----------------------------------------------------------------
# Retirer les en-tetes/pieds de page repetes avant le chunking.
STRIP_BOILERPLATE=true

CHUNK_TOKENS=800
CHUNK_OVERLAP_TOKENS=150

# Debit. Un compte SANS moyen de paiement enregistre est plafonne a
# 3 requetes et 10 000 tokens par minute : garder les valeurs ci-dessous.
# Avec un moyen de paiement (les 200 M de tokens offerts s'appliquent
# toujours), passer a 200 / 800000 pour aller beaucoup plus vite.
MAX_REQUESTS_PER_MINUTE=2
MAX_TOKENS_PER_MINUTE=8000

# --- Chemins locaux ----------------------------------------------------------
INDEX_DIR=./data/index
CACHE_DIR=./data/cache
