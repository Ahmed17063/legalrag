{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./old/**)",
      "Edit(./old/**)",
      "Bash(cat old/*)",
      "Bash(head old/*)",
      "Bash(tail old/*)",
      "Bash(less old/*)",
      "Bash(more old/*)",
      "Bash(sed *old/*)",
      "Bash(awk *old/*)",
      "Bash(grep *old/*)",
      "Bash(rg *old/*)",
      "Bash(cd old*)"
    ]
  }
}
