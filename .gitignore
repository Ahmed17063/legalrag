# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Ignore virtual environments
venv*/
**/venv/
**/venv*/
# Ignore Python bytecode caches
__pycache__/
**/__pycache__/


# node files
node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


# Environnements virtuels uv / python (le motif venv*/ ci-dessus ne matche pas .venv)
.venv/
**/.venv/

# Cache uv
.uv/

# Réglages Claude Code personnels
.claude/settings.local.json

# Secrets : cles d'API et credentials Google (JAMAIS commites)
.env
.env.*
!.env.example
secrets/
*service-account*.json
*credentials*.json

# Donnees generees : cache de telechargement et index d'embeddings.
# On exclut le CONTENU et non le repertoire : git n'entre jamais dans un
# repertoire exclu, et l'exception ci-dessous serait sans effet.
data/*
# Le registre des statuts est un travail de qualification juridique fait a
# la main, pas une donnee generee : le perdre couterait cher.
!data/statuts.json
# Perimetre d'interrogation : petit, et il decrit ce que le service repond.
!data/perimetre.json

# Artefacts de build (pip install -e .)
*.egg-info/
build/
dist/

# Corpus PDF source (volumineux, non versionne)
Documents_juridiques/

# Prototypes anterieurs (Groq, Ollama, modele Hassania) : conserves en local
# comme aide-memoire, hors du depot car susceptibles de contenir des cles.
old/
